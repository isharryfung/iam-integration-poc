# Backend environment configuration
# Copy this to .env and adjust values before running

# MongoDB connection string
MONGO_URI=mongodb://mongo:27017/iam_poc

# Server port
PORT=4000

# Comma-separated list of valid API keys (rotate regularly in production)
API_KEYS=poc-dev-key-1234,poc-dev-key-5678

# Comma-separated list of allowed email domains
# Expand when connect.ust.hk / family.ust.hk go live
ALLOWED_EMAIL_DOMAINS=ust.hk

# Node environment
NODE_ENV=development
