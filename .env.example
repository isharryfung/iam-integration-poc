# ─────────────────────────────────────────────────────────────────────────────
# IAM Integration POC — Root Environment Example
# Copy to .env and adjust for your local setup.
# ─────────────────────────────────────────────────────────────────────────────

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/iam_poc

# ── Backend ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Comma-separated valid API keys (keep secret in production!)
API_KEYS=poc-dev-key-1234,poc-dev-key-5678

# Allowed email domains — expand when go live with connect/family
ALLOWED_EMAIL_DOMAINS=ust.hk

# ── Frontend ──────────────────────────────────────────────────────────────────
# URL the browser will use to call the backend API
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_KEY=poc-dev-key-1234

# ── Reporting Line Resolver Integration ───────────────────────────────────────
# Base URL of the downstream Reporting Line service (no trailing slash)
REPORTING_LINE_API_BASE_URL=https://reporting-line.internal.example.com

# OAuth2 token endpoint for client credentials flow
REPORTING_LINE_TOKEN_URL=https://auth.internal.example.com/oauth2/token

# OAuth2 client credentials (keep secret — never exposed to frontend)
REPORTING_LINE_CLIENT_ID=iam-client-id
REPORTING_LINE_CLIENT_SECRET=iam-client-secret

# OAuth2 scope (default: approver.resolve)
REPORTING_LINE_SCOPE=approver.resolve
